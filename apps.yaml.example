# Copy to <appdaemon>/apps/apps.yaml (OUTSIDE this repo folder) and fill in your own values.
# Everything personal lives there; tools/privacy_scan.py blocks any of these values from the repo.

wa_selftest:
  module: wa_selftest
  class: WaSelfTest
  start_delay: 20
  notify_always: false
  notify_entity: notify.example            # Telegram / mobile notify entity
  groups:                                  # WhatsApp group id (without @g.us) -> child key
    "GROUP_ID_1": kid_a
    "GROUP_ID_2": kid_b
  groups_helper: input_text.example_groups # optional extra group ids, comma separated
  last_webhook_helper: input_datetime.example_last_webhook
  queue_todo: todo.example_queue
  waha_running: binary_sensor.example_waha_running
  waha_url: http://waha.local:3000
  waha_header_file: /homeassistant/.waha_curl_header   # one line: "X-Api-Key: <key>"
  ai_task_entity: ai_task.example
  weekly_sensors: []
  automations: []

wa_ingest:
  module: wa_ingest
  class: WaIngest
  shadow: false                            # true = run next to an existing pipeline, compare, never act
  groups:
    "GROUP_ID_1": kid_a
    "GROUP_ID_2": kid_b
  groups_helper: input_text.example_groups
  alert_names: [KidA, KidB, FamilyName]    # names that trigger a real-time "your kid was mentioned" alert
  data_dir: /homeassistant/appdaemon/data
  media_root: wa_media                     # folder under /media, must be ASCII
  alert_group_labels:                      # group name shown in real-time alerts
    "GROUP_ID_1": "Class 2A"
    "GROUP_ID_2": "Kindergarten parents"
  waha_url: http://waha.local:3000
  waha_header_file: /homeassistant/.waha_curl_header
  ai_task_entity: ai_task.example
  output_language: Hebrew

wa_summary:
  module: wa_summary
  class: WaSummary
  shadow: true
  data_dir: /homeassistant/appdaemon/data
  ai_task_entity: ai_task.example
  tasks_todo: todo.example_tasks
  output_language: Hebrew                  # language of everything the model writes
  times: {evening: "21:00:00", morning: "07:30:00"}
  family_intro: "Two kids: KidA (2nd grade) and KidB (kindergarten). Parents: ParentA and ParentB."
  child_names: [KidA, KidB]
  school_children: [KidA]
  names_mention: "KidA, KidB (or FamilyName)"
  group_labels:
    "GROUP_ID_1": "Class 2A teacher -> KidA"
    "GROUP_ID_2": "Kindergarten parents -> KidB"
  notify_entity: notify.example
  whatsapp_to: "<family contact>@c.us"
  telegram_config_entry: <telegram bot config entry id>
  waha_url: http://waha.local:3000
  waha_header_file: /homeassistant/.waha_curl_header
  calendars_helper: input_text.example_calendars   # comma separated calendars for parent events
  last_summary_helper: input_text.example_last_summary
  issur_melacha_sensor: binary_sensor.example_shabbat_or_holiday
  school_calendar_sensor: sensor.example_school_calendar
  titles: {evening: "📚 Evening summary", morning: "📚 Morning summary"}

wa_morning:
  module: wa_morning
  class: WaMorning
  data_dir: /homeassistant/appdaemon/data
  shadow: false
  notify_entity: notify.example
  whatsapp_to: "<family contact>@c.us"
  telegram_config_entry: <telegram bot config entry id>
  waha_url: http://waha.local:3000
  waha_header_file: /homeassistant/.waha_curl_header
  evening_schedule_time: "21:05:00"              # tomorrow's schedule to the WhatsApp contact
  tasks_todo: todo.example_tasks
  school_calendar_sensor: sensor.example_school_calendar   # attribute elementary_vacation
  issur_melacha_sensor: binary_sensor.example_shabbat_or_holiday
  kids:
    - {key: kid_a, name: KidA, school: true, pointer: input_text.example_plan_kid_a, sensor: sensor.example_weekly_plan_kid_a}

wa_night:
  module: wa_morning
  class: WaNight
  shadow: false
  data_dir: /homeassistant/appdaemon/data
  notify_entity: notify.example
  alerts_to_whatsapp: true
  whatsapp_to: "<family contact>@c.us"
  waha_url: http://waha.local:3000
  waha_header_file: /homeassistant/.waha_curl_header

wa_publish:
  module: wa_publish
  class: WaPublish
  apps_yaml: /homeassistant/appdaemon/apps/apps.yaml
  deploy_key: /homeassistant/.github_deploy/id_ed25519
  remote: git@github.com:<you>/<repo>.git
  git_name: <you>
  git_email: <you>@users.noreply.github.com
